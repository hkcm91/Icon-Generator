# Optional. Set this to have the deployment supply the key for every visitor —
# suitable for a private deployment, since it means you pay for everyone.
#
# Leave it unset to have each person add their own key in the app instead; that
# key stays in their browser and is sent per request.
REPLICATE_API_TOKEN=r8_your_token_here

# Local dev only.
PORT=8787

# Unattended MCP generation. All values below are server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ICON_AUTOMATION_SECRET=replace_with_a_long_random_secret
ICON_MCP_BEARER_TOKEN=replace_with_a_different_long_random_secret
PUBLIC_BASE_URL=https://your-deployment.example
ICON_AUTOMATION_BUCKET=icon-automation
