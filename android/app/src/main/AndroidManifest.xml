<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The wallpaper picker only lists services that declare this. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/wallpaper_thumb"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- A WallpaperService is selectable but not launchable. This entry
             makes an installed APK open the system preview/apply screen. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:icon="@drawable/wallpaper_thumb"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ShakerWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Kept after Liquid Shaker so compatible pickers present it below
             the existing wallpaper. It also gets its own launcher icon. -->
        <activity
            android:name=".WaterToyLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/water_toy_name"
            android:icon="@drawable/water_toy_liquid_core"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WaterToyWallpaperService"
            android:exported="true"
            android:label="@string/water_toy_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/water_toy_wallpaper" />
        </service>

        <!-- The lava lamp: the same engine on a third page. -->
        <activity
            android:name=".LavaLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/lava_name"
            android:icon="@drawable/wallpaper_thumb_lava"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LavaWallpaperService"
            android:exported="true"
            android:label="@string/lava_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_lava" />
        </service>
    </application>
</manifest>
